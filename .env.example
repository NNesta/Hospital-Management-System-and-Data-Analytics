# Copy to .env and fill in. .env is git-ignored: never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 8.4 LTS (see README step 2 for the CREATE DATABASE / USER commands)
DB_NAME=hospital_db
DB_USER=hms_user
DB_PASSWORD=choose-a-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: hospital identity shown in the sidebar, footer and printed invoices
# HOSPITAL_NAME=Ubuzima Referral Hospital
# HOSPITAL_SHORT_NAME=Ubuzima HMS
# HOSPITAL_ADDRESS=KG 7 Ave, Kacyiru, Gasabo District, Kigali, Rwanda
# HOSPITAL_PHONE=+250 788 300 400
# HOSPITAL_EMAIL=info@ubuzima-hospital.rw
# HOSPITAL_TIN=102345678
